{
    "Author": "T.J. Lauerman aka ThatSportsGamer",
    "CodePath": "plugin.js",
    "Description": "Shows live baseball scores on your Stream Deck: MLB, the minors, Rookie ball, the Arizona Fall League and winter leagues. Follow one team per key, or fill a group of keys with a whole slate of games.",
    "Name": "Live MLB Scores",
    "UUID": "com.tj.livemlbscores",
    "Category": "Live Sports Scores",
    "URL": "https://github.com/ThatSportsGamer/live-mlb-scores-for-stream-deck",
    "Icon": "imgs/plugin-icon",
    "CategoryIcon": "imgs/category-icon",
    "Version": "2.0.0.0",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "10.15"
        },
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "24",
        "Debug": "disabled"
    },
    "Actions": [
        {
            "Name": "Live MLB Scores",
            "UUID": "com.tj.livemlbscores.score",
            "Icon": "imgs/action-icon",
            "Tooltip": "Shows live score for your chosen baseball team (MLB, minors, winter leagues). Updates every 30 seconds.",
            "PropertyInspectorPath": "property-inspector.html",
            "States": [
                {
                    "Image": "imgs/action-icon",
                    "Title": ""
                }
            ],
            "SupportedInMultiActions": false
        },
        {
            "Name": "Live MLB Scoreboard",
            "UUID": "com.tj.livemlbscores.scoreboard",
            "Icon": "imgs/scoreboard-icon",
            "Tooltip": "Fills a group of keys with every game in MLB or a league today. Updates every 30 seconds.",
            "PropertyInspectorPath": "scoreboard-inspector.html",
            "States": [
                {
                    "Image": "imgs/scoreboard-icon",
                    "Title": ""
                }
            ],
            "SupportedInMultiActions": false
        }
    ]
}